generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
  DELETING
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum GenerationMode {
  TEXT_TO_IMAGE
  IMAGE_EDIT
  INPAINT
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  FIRST_LAST_FRAME_TO_VIDEO
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AssetRole {
  UPLOAD
  MASK
  OUTPUT
  THUMBNAIL
}

model User {
  id               String                @id @default(uuid())
  username         String                @unique
  displayName      String?
  passwordHash     String
  role             UserRole              @default(USER)
  status           UserStatus            @default(PENDING)
  mustChangePwd    Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  conversations    Conversation[]
  jobs             GenerationJob[]
  assets           Asset[]
  quotaEvents      QuotaEvent[]
  promptEntries    PromptEntry[]
  auditLogs        AuditLog[]            @relation("AuditActor")
  usage            UserUsage?
  mfaCredential    MfaCredential?
  groupMemberships UserGroupMembership[]
  teamMemberships  WorkTeamMembership[]
  assetShares      AssetShare[]          @relation("AssetShareActor")

  @@index([status])
  @@index([createdAt, id])
}

model MfaCredential {
  userId               String            @id
  encryptedSecret      String
  enabledAt            DateTime          @default(now())
  lastAcceptedTimeStep BigInt?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes        MfaRecoveryCode[]
}

model MfaRecoveryCode {
  id           String        @id @default(uuid())
  credentialId String
  codeHash     String        @unique
  consumedAt   DateTime?
  createdAt    DateTime      @default(now())
  credential   MfaCredential @relation(fields: [credentialId], references: [userId], onDelete: Cascade)

  @@index([credentialId, consumedAt])
}

model UserUsage {
  userId       String   @id
  storageBytes BigInt   @default(0)
  activeJobs   Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlobalUsage {
  id         String   @id
  activeJobs Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model StylePreset {
  id               String   @id
  nameZh           String
  nameEn           String
  suffix           String   @db.Text
  previewObjectKey String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder, id])
}

model PromptPolishSetting {
  id                String    @id
  name              String
  providerName      String
  baseUrl           String
  encryptedApiKey   String
  modelId           String
  timeoutSeconds    Int       @default(60)
  enabled           Boolean   @default(true)
  systemPrompt      String?   @db.Text
  supportsImageEdit Boolean   @default(false)
  testCooldownUntil DateTime?
  lastTestOk        Boolean?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Provider {
  id                String    @id @default(uuid())
  name              String    @unique
  baseUrl           String
  encryptedApiKey   String
  encryptedHeaders  String?
  timeoutSeconds    Int       @default(180)
  pollTimeoutSeconds Int      @default(900)
  enabled           Boolean   @default(true)
  archivedAt        DateTime?
  testCooldownUntil DateTime?
  lastTestOk        Boolean?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  models            Model[]
}

model Model {
  id                 String             @id @default(uuid())
  providerId         String
  displayName        String
  upstreamModelId    String
  adapterKind        String             @default("openai-images")
  mediaKind          MediaKind          @default(IMAGE)
  supportsGeneration     Boolean            @default(true)
  supportsEdit           Boolean            @default(false)
  supportsInpaint        Boolean            @default(false)
  supportsFirstLastFrame Boolean            @default(false)
  allowedSizes       Json
  allowedQualities   Json
  allowedDurations   Json               @default("[]")
  resolutionTiers    Json               @default("[]")
  allowedRatios      Json               @default("[]")
  maxImages          Int                @default(1)
  maxInputImages     Int                @default(1)
  defaults           Json
  enabled            Boolean            @default(true)
  sortOrder          Int                @default(0)
	costPerUnit        Int                @default(1)
	pointMultipliers   Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  provider           Provider           @relation(fields: [providerId], references: [id])
  jobs               GenerationJob[]
  allowedGroups      ModelGroupAccess[]

  @@unique([providerId, upstreamModelId])
  @@index([enabled, sortOrder])
}

model UserGroup {
  id          String                @id @default(uuid())
  name        String                @unique
  description String?
  quotaWindow        String?
  quotaPoints       Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  users  UserGroupMembership[]
  models ModelGroupAccess[]
}

model WorkTeam {
  id          String                @id @default(uuid())
  name        String                @unique
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  users       WorkTeamMembership[]
  assetShares AssetShare[]
}

model WorkTeamMembership {
  userId     String
  teamId     String
  assignedAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       WorkTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
}

model UserGroupMembership {
  userId     String
  groupId    String
  assignedAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

model ModelGroupAccess {
  modelId String
  groupId String
  model   Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([modelId, groupId])
  @@index([groupId])
}

model Conversation {
  id        String          @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs      GenerationJob[]

  @@index([userId, updatedAt, id])
}

model PromptEntry {
  id          String   @id @default(uuid())
  userId      String
  prompt      String   @db.Text
  promptHash  String
  isFavorite  Boolean  @default(false)
  usageCount  Int      @default(1)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptHash])
  @@index([userId, isFavorite, lastUsedAt, id])
  @@index([userId, lastUsedAt, id])
}

model GenerationJob {
  id             String         @id @default(uuid())
  userId         String
  conversationId String
  modelId        String?
  mediaKind      MediaKind      @default(IMAGE)
  mode           GenerationMode
  status         JobStatus      @default(QUEUED)
  prompt         String
  parameters     Json
  modelSnapshot  Json
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  quotaReleased  Boolean        @default(false)
  imageCount     Int            @default(1)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  model          Model?         @relation(fields: [modelId], references: [id], onDelete: SetNull)
  assets         Asset[]
  quotaEvents    QuotaEvent[]

  @@index([userId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([status])
  @@index([modelId])
}

model Asset {
  id           String         @id @default(uuid())
  userId       String
  jobId        String?
  role         AssetRole
  mediaKind    MediaKind      @default(IMAGE)
  objectKey    String         @unique
  mimeType     String
  sizeBytes    BigInt
  width        Int?
  height       Int?
  durationMs   Int?
  originalName String?
  note         String?
  contentHash  String?
  deletedAt    DateTime?
  purgeAfter   DateTime?
  purgedAt     DateTime?
  createdAt    DateTime       @default(now())
  thumbnailForId String?      @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          GenerationJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  thumbnailFor Asset?         @relation("AssetThumbnail", fields: [thumbnailForId], references: [id], onDelete: Cascade)
  thumbnail    Asset?         @relation("AssetThumbnail")
  shares       AssetShare[]

  @@index([userId, createdAt])
  @@index([userId, role, deletedAt])
  @@index([userId, role, contentHash])
  @@index([userId, deletedAt, createdAt, id])
  @@index([userId, deletedAt, purgedAt, createdAt, id])
  @@index([purgeAfter, purgedAt])
  @@index([jobId])
}

model QuotaEvent {
  id         String         @id @default(uuid())
  userId     String
  jobId      String
  modelId    String?
  imageCount   Int      @default(0)
  videoSeconds Int      @default(0)
	points       Int      @default(0)
  kind         String
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        GenerationJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([jobId])
  @@index([createdAt])
}

model AssetShare {
  id         String    @id @default(uuid())
  assetId    String
  teamId     String
  sharedById String
  createdAt  DateTime  @default(now())
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  team       WorkTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sharedBy   User      @relation("AssetShareActor", fields: [sharedById], references: [id], onDelete: Cascade)

  @@unique([assetId, teamId])
  @@index([teamId, createdAt, id])
  @@index([sharedById])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}
