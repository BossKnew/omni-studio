{
  "name": "@omnistudio/api",
  "version": "0.3.0",
  "private": true,
  "description": "OmniStudio API and background worker.",
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "secrets:rotate": "node dist/rotate-provider-secrets.js",
    "mfa:rotate-secrets": "node dist/rotate-mfa-secrets.js",
    "mfa:reset": "node dist/reset-mfa.js",
    "assets:backfill-thumbnails": "node dist/backfill-thumbnails.js",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "prisma": "^7.9.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.1.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "stream-json": "^3.5.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
