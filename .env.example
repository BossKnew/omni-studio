# OmniStudio Docker Compose configuration
# Copy this file to .env, replace every change-me value, and keep .env private.

# Leave this empty. The optional compose.external.yml overlay assigns bundled
# services to the `bundled` profile and disables them unless explicitly enabled.
COMPOSE_PROFILES=

# Bundled PostgreSQL / Redis
POSTGRES_DB=omnistudio
POSTGRES_USER=omnistudio
# Generate independently with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password

# External services (percent-encode URL credentials). Use these together with
# the compose.external.yml overlay so bundled services are not started.
# DATABASE_URL=postgresql://user:password@db.example:5432/omnistudio?sslmode=require&connection_limit=5
# REDIS_URL=rediss://user:password@cache.example:6380/0

# Encryption keys. Each key must be an independent 32-byte Base64 value:
# openssl rand -base64 32
PROVIDER_SECRET_KEY=change-me-32-byte-base64-key
MFA_SECRET_KEY=change-me-another-32-byte-base64-key
# PROVIDER_SECRET_KEYS=primary:<new-key>,old:<old-key>
# MFA_SECRET_KEYS=primary:<new-key>,old:<old-key>
# MFA_SECRET_ACTIVE_KID=primary
MFA_ISSUER=OmniStudio

# Bootstrap account. Remove both values and recreate api after first login,
# password change, and MFA enrollment.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password-at-least-15-characters

# Default: local browser access only. For LAN access use a private IP origin,
# set HTTP_BIND_ADDRESS=0.0.0.0, and keep FORWARDED_HEADERS_MODE=ignore.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
APP_ORIGINS=http://localhost:8080
ALLOW_INSECURE_HTTP=true

# Use trusted-single-proxy only when OmniStudio is reachable exclusively through
# one trusted reverse proxy that overwrites X-Real-IP and X-Forwarded-Proto.
FORWARDED_HEADERS_MODE=ignore

# Optional private provider access. Public providers remain HTTPS-only.
# OUTBOUND_PRIVATE_ALLOWLIST=images.internal.example,10.20.0.0/16
# OUTBOUND_HTTP_ALLOWLIST=images.internal.example:8080
OUTBOUND_PRIVATE_ALLOWLIST=
OUTBOUND_HTTP_ALLOWLIST=

# Quotas and worker limits
# Per-user generation image quotas are configured in Admin → User groups
# (sliding window, e.g. 5 images / 5h), not by environment variable.
MAX_ACTIVE_JOBS_PER_USER=3
MAX_QUEUED_JOBS=200
USER_STORAGE_QUOTA_GIB=10
MAX_SSE_CONNECTIONS_PER_USER=3
LOGIN_IP_LIMIT=50
LOGIN_PAIR_LIMIT=10
LOGIN_ACCOUNT_FAILURE_LIMIT=30
REGISTRATION_IP_LIMIT=5
GENERATION_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=30
MAX_CONCURRENT_UPLOADS_PER_USER=2
WORKER_CONCURRENCY=1
VIDEO_WORKER_CONCURRENCY=1
IMAGE_PROCESSING_CONCURRENCY=1
# Combined HTTP+worker in one process (default). Use compose.worker.yml to split.
PROCESS_ROLE=all
PASSWORD_HASH_CONCURRENCY=1
MEDIA_X_ACCEL_REDIRECT=true

# Resource tuning for the default 2 CPU / 4 GiB profile
APP_UID=1000
APP_GID=1000
API_MEMORY_LIMIT=1536m
API_CPU_LIMIT=1.5
NODE_HEAP_MIB=768
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_CPU_LIMIT=0.75
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.25
NGINX_MEMORY_LIMIT=128m
NGINX_CPU_LIMIT=0.25
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAX_WAL_SIZE=512MB

# Use a named volume by default. An absolute Linux path such as
# /srv/omnistudio/media enables a host bind mount instead.
MEDIA_VOLUME=media_data

# Traefik overlay settings
APP_HOST=studio.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional compose.secrets.yml overlay
# SECRETS_DIR=./secrets
