{
  "name": "omnistudio",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted image and video generation workspace with a secure Docker Compose deployment.",
  "author": "BossKnew",
  "contributors": ["BossKnew"],
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @omnistudio/api && npm run build -w @omnistudio/web",
    "test": "npm run test -w @omnistudio/api && npm run test -w @omnistudio/web",
    "lint": "npm run lint -w @omnistudio/api && npm run lint -w @omnistudio/web",
    "db:generate": "npm run db:generate -w @omnistudio/api",
    "db:migrate": "npm run db:migrate -w @omnistudio/api",
    "assets:backfill-thumbnails": "npm run assets:backfill-thumbnails -w @omnistudio/api",
    "licenses:check": "node scripts/check-licenses.mjs",
    "security-configs:check": "node scripts/check-security-configs.mjs",
    "compose-security:check": "node scripts/run-compose-security.mjs"
  },
  "engines": { "node": ">=24 <25" },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "fast-uri": "3.1.7",
    "js-yaml": "3.15.2",
    "multer": "2.4.0",
    "mysql2": "3.24.4"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "argon2": true,
    "fsevents": false,
    "msgpackr-extract": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
